# @capacitor-firebase/authentication@7.5.0 declares `peerOptional firebase@^11.2.0`
# while this project runs firebase@^12.x. npm's strict peer resolution turns that
# into a hard ERESOLVE failure, so `npm install` exits 1 on any clean checkout -
# Vercel builds included. It only ever succeeded here because node_modules predates
# the plugin being added.
#
# The conflict is cosmetic: the peer is OPTIONAL and the plugin's Android path uses
# the native Firebase SDK, not the JS one, so the major version of `firebase` on the
# web side does not affect it.
legacy-peer-deps=true
