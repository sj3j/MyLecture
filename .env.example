# Copy to .env and fill in. Never commit .env - only this file is tracked.
# On Vercel these live in the project's Environment Variables; the .env file is
# NOT deployed, so anything set only here will be missing in production.

# ─── App ────────────────────────────────────────────────────────────────────

# Public origin, no trailing slash. ZainCash returns the customer to
# {APP_URL}/api/zaincash/success and the webhook is registered under the same
# origin. resolveAppOrigin() rejects anything that is not https:// (except an
# explicit http://localhost for local dev), so this cannot silently stay unset.
APP_URL=https://my-lecture.vercel.app

# ─── Firebase Admin (server-side writes; bypasses firestore.rules) ──────────

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The full PEM, newlines written as literal \n.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ─── ZainCash Payment Gateway v2 ───────────────────────────────────────────

# Selects both the host AND the credentials: uat | production.
# Keep this on uat until a sandbox payment has proved which secret signs the
# callbacks. With ZAINCASH_ENV=production, payments are REAL.
ZAINCASH_ENV=uat
ZAINCASH_BASE_URL_UAT=https://pg-api-uat.zaincash.iq
ZAINCASH_BASE_URL_PRODUCTION=https://pg-api.zaincash.iq

# Every credential below also accepts _UAT / _PRODUCTION suffixes, which win
# over the plain name. The docs require separate credentials per environment,
# and this is what stops the published sandbox pair reaching production.
#
# The sandbox merchant (9647829744545) is printed in ZainCash's own docs, so it
# is not a secret. Test wallets: 9647802999569, 9647829744432, 9647829744464,
# 9647829744474 - all PIN 1111, OTP 111111.
ZAINCASH_CLIENT_ID_UAT=758055f4a8044779a35f6ceb69f858b3
ZAINCASH_CLIENT_SECRET_UAT=bibLCGTxVAig5To3OLLKPJQMlRR7Pefp
ZAINCASH_CLIENT_ID_PRODUCTION=
ZAINCASH_CLIENT_SECRET_PRODUCTION=
ZAINCASH_SCOPES=payment:read payment:write reverse:write

# The HS256 secret that signs redirect + webhook JWTs. ZainCash call it the
# "API Secret Key" and have not issued one; their business team says the
# credentials already provided are "standard for all our merchants". Until a
# real callback settles it, verifyGatewayToken() tries this and then falls back
# to the client secret, logging which one worked. PENDING_FROM_SUPPORT is
# collapsed to "" so it can never be used as a literal key.
ZAINCASH_JWT_SECRET=PENDING_FROM_SUPPORT
# Accepted alias for the same secret. ZAINCASH_JWT_SECRET wins when both are set.
ZAINCASH_API_KEY=

# serviceType sent on transaction/init. Their parameter table calls this
# "provided by ZainCash", but the FAQ is explicit that it is merchant-defined:
# any value that helps classify your services. It names the product in the
# merchant dashboard.
ZAINCASH_SERVICE_TYPE=MohadaratySubscription

# Merchant wallet. Reference only: v2 identifies the merchant by OAuth2 client
# and sends no msisdn in any request.
ZAINCASH_MSISDN=

# ─── Cron ───────────────────────────────────────────────────────────────────

# Shared secret for /api/cron/*. The season rollover fails closed without it,
# so it must be set on Vercel even though nothing needs it locally.
CRON_SECRET=

# ─── Media storage (Cloudflare R2) ─────────────────────────────────────────

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Integrations ──────────────────────────────────────────────────────────

GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Phone number that unlocks the SuperKey admin flow.
SUPERKEY_PHONE_NUMBER=6262610089
